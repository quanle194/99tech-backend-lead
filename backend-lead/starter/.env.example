PORT=3000
DATABASE_URL=postgres://wallet:wallet@localhost:5439/wallet
DATABASE_URL_TEST=postgres://wallet:wallet@localhost:5439/wallet_test
# HMAC secret for PSP callbacks (X-Psp-Signature: sha256=<hex HMAC-SHA256 of the raw body>).
PSP_WEBHOOK_SECRET=
# Without a secret, callbacks are refused unless this is true: local use with the brief's unsigned mock PSP.
PSP_ALLOW_UNSIGNED=true
